# Copia este archivo a `.env` y rellena tus claves.
# El backend las usa cuando la UI no envía las suyas (⌘ , en la app).

# Claude — selección Scout → Verify de los clips
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Deepgram Nova — transcripción rápida en la nube (opcional).
# Si lo dejas vacío se usa Whisper en local.
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# Servidor (opcional)
HOST=127.0.0.1
PORT=8000
